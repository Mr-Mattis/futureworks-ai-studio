{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureworks.local/schemas/recovery-policy/v1.0.0/operation_identity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,79}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision",
        "sha256"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^S[0-9]{2,3}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_account_reference": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_asset_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "generation_intent": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "manifest_ref",
    "job_id",
    "scene_id",
    "provider",
    "provider_account_reference",
    "operation",
    "model_version",
    "request_sha256",
    "input_asset_sha256",
    "generation_intent"
  ]
}
