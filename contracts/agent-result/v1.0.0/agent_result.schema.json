{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureworks.local/schemas/agent-result/v1.0.0/agent_result.schema.json",
  "title": "Future Works AI Studio Agent Result v1.0.0",
  "description": "Terminal agent handoff envelope. Output is the unmodified role-native planning payload, not executable instructions or production approval. Use validate_agent_result.py for manifest and cross-field checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "creative_director",
            "executive_producer",
            "sop_knowledge",
            "growth_strategist",
            "quality_control",
            "editing_supervisor",
            "budget_controller",
            "avatar_director",
            "visual_director",
            "research_agent"
          ]
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "instance_id"
      ]
    },
    "scope": {
      "enum": [
        "episode",
        "studio"
      ]
    },
    "input_manifest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": "1.0.0"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,79}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "schema_version",
            "project_id",
            "revision",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "succeeded",
            "needs_revision",
            "blocked",
            "failed"
          ]
        }
      },
      "required": [
        "run_id",
        "attempt",
        "started_at",
        "finished_at",
        "status"
      ]
    },
    "output": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "scene_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^S[0-9]{2,3}$"
              }
            },
            "required": [
              "code",
              "severity",
              "message",
              "path",
              "scene_id"
            ]
          }
        }
      },
      "required": [
        "status",
        "findings"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "details"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spend_authorized": {
          "const": false
        },
        "publish_authorized": {
          "const": false
        },
        "production_approved": {
          "const": false
        }
      },
      "required": [
        "spend_authorized",
        "publish_authorized",
        "production_approved"
      ]
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "agent",
    "scope",
    "input_manifest",
    "execution",
    "output",
    "validation",
    "errors",
    "blockers",
    "authorization"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "episode"
          }
        }
      },
      "then": {
        "properties": {
          "input_manifest": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": "1.0.0"
              },
              "project_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,79}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "schema_version",
              "project_id",
              "revision",
              "sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "studio"
          }
        }
      },
      "then": {
        "properties": {
          "input_manifest": {
            "type": "null"
          },
          "agent": {
            "properties": {
              "role": {
                "enum": [
                  "growth_strategist",
                  "sop_knowledge"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "type": "object"
          },
          "errors": {
            "maxItems": 0
          },
          "blockers": {
            "maxItems": 0
          },
          "validation": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "needs_revision"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "type": "object"
          },
          "validation": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          },
          "output": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "findings": {
                "items": {
                  "properties": {
                    "severity": {
                      "enum": [
                        "info",
                        "warning"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "properties": {
              "role": {
                "const": "creative_director"
              }
            }
          },
          "output": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "type": "object",
            "required": [
              "project_id",
              "working_title",
              "opening_hook",
              "logline",
              "closing_cta",
              "disclosure_note",
              "sections",
              "scenes",
              "shorts_ideas",
              "open_questions",
              "metadata_draft"
