                "items": {}
              },
              "open_questions": {
                "type": "array",
                "items": {}
              },
              "metadata_draft": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "properties": {
