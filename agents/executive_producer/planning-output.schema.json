{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P02.01 development planning profile v0.1.0",
  "description": "Narrow role validation; does not amend the accepted P01 contracts or authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "working_title", "content_type", "story_goal", "target_audience", "creative_constraints", "work_packages", "gates", "estimated_scene_count", "assumptions", "blockers", "next_action"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,79}$"},
    "working_title": {"type": "string", "minLength": 1, "maxLength": 300},
    "content_type": {"enum": ["REAL_BUILD", "AI_CONCEPT", "HYBRID"]},
    "story_goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "target_audience": {"type": "string", "minLength": 1, "maxLength": 2000},
    "creative_constraints": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "estimated_scene_count": {"type": "integer", "minimum": 1, "maximum": 999},
    "assumptions": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "blockers": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 2000},
    "work_packages": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["package_id", "stage", "owner", "task", "required_inputs", "deliverable", "dependencies"],
        "properties": {
          "package_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "stage": {"enum": ["research", "script", "visual", "avatar", "budget", "assembly", "qc"]},
          "owner": {"enum": ["research_agent", "creative_director", "visual_director", "avatar_director", "budget_controller", "editing_supervisor", "quality_control"]},
          "task": {"type": "string", "minLength": 1, "maxLength": 4000},
          "required_inputs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
          "deliverable": {"type": "string", "minLength": 1, "maxLength": 4000},
          "dependencies": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
        }
      }
    },
    "gates": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "owner", "pass_conditions"],
        "properties": {
          "name": {"enum": ["human_approval", "budget_approval", "publication_approval"]},
          "owner": {"const": "human_owner"},
          "pass_conditions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
        }
      }
    }
  }
}
